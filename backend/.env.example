# PayPal Developer sandbox app (developer.paypal.com/dashboard -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
USE_MOCK_PAYPAL=0

# Groq (OpenAI-compatible chat/completions). Comma-separated pool rotates on 429.
GROQ_API_KEYS=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
