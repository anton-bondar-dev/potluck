# PayPal Developer sandbox app (developer.paypal.com/dashboard -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
USE_MOCK_PAYPAL=0

# Groq (OpenAI-compatible chat/completions). Comma-separated pool rotates on 429.
# The agent needs an LLM even in mock mode. A Groq key is free and takes two
# minutes: https://console.groq.com/keys — comma-separate several to rotate.
GROQ_API_KEYS=gsk_put_at_least_one_key_here
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
